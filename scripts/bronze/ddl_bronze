CREATE TABLE bronze.crm_customers (
    cst_id INTEGER,
    cst_key VARCHAR(50) NOT NULL,
    cst_firstname VARCHAR(50),
    cst_lastname VARCHAR(50),
    cst_marital_status VARCHAR(10),
    cst_gndr VARCHAR(10),
    cst_create_date DATE
);

CREATE TABLE bronze.crm_products (
    prd_id INTEGER ,
    prd_key VARCHAR(50) NOT NULL,
    prd_nm VARCHAR(100) NOT NULL,
    prd_cost NUMERIC(10, 2),
    prd_line VARCHAR(10),
    prd_start_dt DATE NOT NULL,
    prd_end_dt DATE
);

CREATE TABLE bronze.crm_sale_details_raw (
    sls_ord_num VARCHAR(50) NOT NULL,
    sls_prd_key VARCHAR(50) NOT NULL,
    sls_cust_id INTEGER NOT NULL,
    sls_order_dt INTEGER NOT NULL, 
    sls_ship_dt INTEGER NOT NULL,  
    sls_due_dt INTEGER NOT NULL,   
    sls_sales NUMERIC(10, 2),
    sls_quantity INTEGER NOT NULL,
    sls_price NUMERIC(10, 2)
);

CREATE TABLE bronze.erm_cust (
    CID VARCHAR(20) ,
    BDATE DATE,
    GEN VARCHAR(20)
);

CREATE TABLE bronze.erm_location (
    CID VARCHAR(20) ,
    CNTRY VARCHAR(50)
);

CREATE TABLE bronze.erm_px_cat (
    ID VARCHAR(10) ,
    CAT VARCHAR(50) NOT NULL,
    SUBCAT VARCHAR(50) NOT NULL,
    MAINTENANCE VARCHAR(10) NOT NULL
);

